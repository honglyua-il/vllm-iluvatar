{
    "schema_version": 1,
    "name": "qwen2_dense_w8a8",
    "load_device": "cpu",
    "model_config_patch": {
        "compression_config": null
    },
    "default_action": "keep",
    "rules": [
        {
            "id": "keep_sensitive_tensor",
            "priority": 1000,
            "match": {
                "regex": [
                    "^lm_head\\.weight$",
                    "^model\\.embed_tokens\\.weight$",
                    "^model\\.norm\\.weight$",
                    "^model\\.layers\\.\\d+\\.(input_layernorm|post_attention_layernorm)\\.weight$"
                ]
            },
            "action": "keep"
        },
        {
            "id": "dense_float_to_w8a8",
            "priority": 800,
            "match": {
                "regex": [
                    "^model\\.layers\\.\\d+\\.self_attn\\.(q_proj|k_proj|v_proj|o_proj)\\.weight$",
                    "^model\\.layers\\.\\d+\\.mlp\\.(gate_proj|up_proj|down_proj)\\.weight$"
                ],
                "dtypes": [
                    "bfloat16"
                ],
                "ndims": [
                    2
                ]
            },
            "action": "convert",
            "config_group": "dense_linears",
            "work_device": true,
            "dequant": {
                "method": "to_float32"
            },
            "quant": {
                "method": "int8_per_channel",
                "options": {
                    "group_size": -1,
                    "symmetric": true,
                    "gemm_format": "TN"
                }
            },
            "iluvatar": {
                "mixed_strategy": "CHANNEL",
                "gemm_mode": "PERF"
            },
            "outputs": {
                "weight_scale": ".weight_scale"
            }
        }
    ]
}
