{
    "schema_version": 1,
    "name": "qwen3_8_dense_w4a8",
    "load_device": "cpu",
    "model_config_patch": {
        "compression_config": null
    },
    "default_action": "keep",
    "rules": [
        {
            "id": "keep_sensitive_tensor",
            "priority": 1000,
            "match": {
                "regex": [
                    "^lm_head\\.weight$",
                    "^model\\.language_model\\.embed_tokens\\.weight$",
                    "^model\\.language_model\\.norm\\.weight$",
                    "^model\\.language_model\\.layers\\.\\d+\\.(input_layernorm|post_attention_layernorm)\\.weight$",
                    "^model\\.language_model\\.layers\\.\\d+\\.self_attn\\.(q_norm|k_norm)\\.weight$",
                    "^model\\.language_model\\.layers\\.\\d+\\.linear_attn\\..*$",
                    "^model\\.visual\\..*$",
                    "^mtp\\.fc\\.weight$",
                    "^mtp\\.norm\\.weight$",
                    "^mtp\\.pre_fc_norm_.*\\.weight$",
                    "^mtp\\.layers\\.\\d+\\.(input_layernorm|post_attention_layernorm)\\.weight$",
                    "^mtp\\.layers\\.\\d+\\.self_attn\\.(q_norm|k_norm)\\.weight$"
                ]
            },
            "action": "keep"
        },
        {
            "id": "dense_float_to_w4a8",
            "priority": 800,
            "match": {
                "regex": [
                    "^(?:model\\.language_model|mtp)\\.layers\\.\\d+\\.self_attn\\.(q_proj|k_proj|v_proj|o_proj)\\.weight$",
                    "^(?:model\\.language_model|mtp)\\.layers\\.\\d+\\.mlp\\.(gate_proj|up_proj|down_proj)\\.weight$"
                ],
                "dtypes": [
                    "bfloat16"
                ],
                "ndims": [
                    2
                ]
            },
            "action": "convert",
            "config_group": "dense_linears",
            "work_device": true,
            "dequant": {
                "method": "to_float32"
            },
            "quant": {
                "method": "int4_per_channel",
                "options": {
                    "group_size": -1,
                    "symmetric": true,
                    "gemm_format": "NN",
                    "scale_div": 18,
                    "weight_layout": "packed_nn"
                }
            },
            "outputs": {
                "weight_scale": ".weight_scale"
            }
        }
    ]
}
